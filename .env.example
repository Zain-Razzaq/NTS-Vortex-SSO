# ── Public / networking ──────────────────────────────────────────────
# The public URL of Vortex (this middleware), used to build the CRM
# returnUrl and to build the internal callback link.
APP_PUBLIC_URL=https://vortex.ntsconnect.com

# Internal address of the Open WebUI container on Coolify's docker
# network. Do NOT expose Open WebUI's own domain publicly anymore —
# only this middleware should be reachable from the internet.
OPEN_WEBUI_INTERNAL_URL=http://open-webui:8080

# ── NTS CRM SSO ───────────────────────────────────────────────────────
# The CRM's login page (same one Sales Tracker uses).
CRM_LOGIN_URL=https://crm.ntsconnect.com/Account/Login

# HS256 shared secret used to sign the CRM's JWTs.
# ⚠️ Get this from the NTS CRM team (Sajid). Do not commit the real value.
NTS_JWT_SECRET=replace-with-real-secret-when-available

# ── Open WebUI admin API key (optional, not currently used) ─────────
# Not required with the current policy (NTS CRM logins auto-create an
# Open WebUI account if one doesn't exist yet, via trusted-header auth).
# Kept here in case you later want to restrict NTS CRM login to only
# pre-existing accounts again — left blank is fine for now.
OPEN_WEBUI_ADMIN_API_KEY=

# ── Middleware's own session ─────────────────────────────────────────
# Random long string, used to sign the middleware's session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-random-string

# Header name Open WebUI is configured to trust (must match
# WEBUI_AUTH_TRUSTED_EMAIL_HEADER set on the Open WebUI service).
TRUSTED_EMAIL_HEADER=X-User-Email
TRUSTED_NAME_HEADER=X-User-Name

# Port this middleware listens on internally.
PORT=3000
